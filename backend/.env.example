# Optional but recommended for production; unauthenticated requests are rate-limited.
DATA_GOV_SG_API_KEY=

# The backend refreshes once per hour. The website polls the published JSON every 5 minutes.
HEATGUARD_REFRESH_SECONDS=3600
DATA_GOV_SG_TIMEOUT_SECONDS=45
LOG_LEVEL=INFO

# Optional path overrides.
# HEATGUARD_MODEL_PATH=/app/backend/model/best_model.pt
# HEATGUARD_METADATA_PATH=/app/backend/model/v4_runtime_metadata.json
# HEATGUARD_DATA_DIR=/app/backend/data

# Community data collection. Records and photos remain private to the backend.
# HEATGUARD_COMMUNITY_DB=/app/runtime/community-submissions.sqlite3
# HEATGUARD_COMMUNITY_UPLOAD_DIR=/app/runtime/community-uploads
HEATGUARD_COMMUNITY_WEEKLY_CAP=10
